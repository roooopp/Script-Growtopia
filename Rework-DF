local function MissingItem()
    for id, quota in pairs(ItemKuota) do
        if Count(id) < quota[1] then return id end
    end
end

local function DropSurplus(storageName)
    if CurrentWorld() ~= storageName then return end
    for id, quota in pairs(ItemKuota) do
        local extra = Count(id) - quota[2]
        if extra > 0 then
            pcall(function() bot:drop(id, extra) end)
            Sleep(800, 1200)
            if Count(id) > quota[2] then
                pcall(function() bot:fastDrop(id, extra) end)
                Sleep(800, 1200)
            end
        end
    end
end

