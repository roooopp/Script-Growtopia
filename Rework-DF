local function ReadLock()
    local owner, stamp
    EachLine(Files.lock, function(line)
        if not owner then owner = line
        elseif not stamp then stamp = tonumber(line) end
    end)
    return (owner ~= "" and owner or nil), stamp
end

local function AcquireLock(me)
    local limit = os.time() + 15
    while os.time() < limit do
        local owner, stamp = ReadLock()
        if owner == nil or stamp == nil or os.time() - stamp > 10 then
            WriteLines(Files.lock, { me, tostring(os.time()) })
            Sleep(100, 250)
            local check = ReadLock()
            if check == me then return true end
        end
        Sleep(150, 400)
    end
    return false
end

local MyNameCache = nil

local function GetMyName()
    if not MyNameCache then
        local name = Try(function() return getLocal().name end) or Try(function() return bot.name end)
        if type(name) == "string" and name ~= "" then MyNameCache = name end
    end
    return MyNameCache or "bot"
end

local function WithLock(fn)
    local me = GetMyName()
    if not AcquireLock(me) then return false end
    local ok, result = pcall(fn)
    local owner = ReadLock()
    if owner == me then WriteLines(Files.lock, {}) end
    return ok and result
end

