end

local function WarpTo(worldName)
    local name, door = string.match(worldName, "^([^|:]+)[|:]?(.*)$")
    name = string.upper(name or worldName)
    if door == "" then door = nil end

    for _ = 1, 3 do
        WaitOnline()
        if door then
            pcall(function() bot:warp(name, door) end)
        else
            pcall(function() bot:warp(name) end)
        end
        Sleep(5000, 6000)
        if CurrentWorld() == name then return true end
    end
    return false
end

local function Approach(x, y)
    if Near(x, y) and not OnTile(x, y) then return true end

    local cands = {}
    for _, o in ipairs(Offsets) do
        local sx, sy = x + o[1], y + o[2]
        if InBounds(sx, sy) then
            local fg = GetTile(sx, sy)
            if fg <= 0 or Passable[fg] then table.insert(cands, { sx, sy }) end
        end
    end

    for _, c in ipairs(cands) do
        pcall(function() bot:findPath(c[1], c[2]) end)
        Sleep(120, 150)
        if Near(x, y) and not OnTile(x, y) then return true end
    end
    return false
end

local function StandAt(sx, sy)
    for _ = 1, 3 do
        if OnTile(sx, sy) then return true end
        pcall(function() bot:findPath(sx, sy) end)
        Sleep(300, 500)
    end
    return OnTile(sx, sy)
end

local function BreakTile(x, y)
    if not InBounds(x, y) then return false end

    local persistent = LockIDs[GetTile(x, y)] == true
    local hits = 0
    local deadline = os.time() + TimeoutBreakTile

    while os.time() < deadline do
        if not StillHere() then return false end

        local fg = GetTile(x, y)
        if fg <= 0 then return true end
        if Unbreakable[fg] or (not persistent and hits >= 40) then return false end

        WaitOnline()
        if Approach(x, y) then
            bot:hit(x, y)
            hits = hits + 1
            Sleep(120, 140)
        else
            Sleep(1000, 2000)
        end
    end
    return false
end

local function PlaceAt(x, y, id)
    if not InBounds(x, y) or not StillHere() or GetTile(x, y) ~= 0 or Count(id) < 1 then
        return false
    end
    WaitOnline()
    if not Approach(x, y) then return false end
    bot:place(x, y, id)
    Sleep(200, 300)
    return GetTile(x, y) == id
end

local function FindDoor()
    for y = 0, 59 do
        for x = 0, 99 do
            if GetTile(x, y) == MainDoorId then return x, y end
        end
    end
end

local function LockTiles()
    local list = {}
    for y = 0, 59 do
        for x = 0, 99 do
            if LockIDs[GetTile(x, y)] then table.insert(list, { x, y }) end
        end
    end
    return list
end

local function FillTile12()
    Sleep(1500, 2000)
    StandAt(0, 2)

    local fg = GetTile(1, 2)

    if LockIDs[fg] then
        BreakTile(1, 2)
    elseif fg > 0 and fg ~= FillId then
        BreakTile(1, 2)
    end

    for _ = 1, 5 do
        if GetTile(1, 2) == FillId then break end
        StandAt(0, 2)
        PlaceAt(1, 2, FillId)
        Sleep(300, 500)
    end
end

local function ClearDoorArea(dx, dy)
    if dx and LockIDs[GetTile(dx, dy - 1)] then BreakTile(dx, dy - 1) end
    FillTile12()
end

local function BreakSmallLock()
    FillTile12()
end

