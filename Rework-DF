local function CollectInWorld()
    for _ = 1, 3 do
        pcall(function() bot:collect(CollectRange, CollectIntervalMs) end)
        Sleep(800, 1200)
        if not MissingItem() then return true end
    end
    return false
end

local function CollectAtStorage(storageName)
    if CurrentWorld() ~= storageName then return false end
    for _ = 1, MaxCollectRounds do
        pcall(function() bot:collect(CollectRange, CollectIntervalMs) end)
        Sleep(1000, 1500)
        DropSurplus(storageName)

        local stable = true
        for _ = 1, VerifyDetik do
            Sleep(1000)
            if MissingItem() then stable = false; break end
        end
        if stable then return true end
    end
    return false
end

local function RestockAtStorage(storageName)
    if WorldStorage == "" then return false end
    if not WarpTo(WorldStorage) then WarpTo(storageName) end
    Sleep(1000, 2000)
    return CollectAtStorage(storageName)
end

-- ============================================================
-- VERIFIKASI
-- ============================================================

local function VerifyWorld(target)
    if CurrentWorld() ~= target then
        return false, "bot tidak berada di world target"
    end

    local locks = LockTiles()
    if #locks > 0 then
        return false, string.format("masih ada lock di (%d,%d)", locks[1][1], locks[1][2])
    end

    local fg = GetTile(1, 2)
    if fg ~= FillId then
        return false, string.format("(1,2) harus Dirt (id=%d), sekarang tile=%d", FillId, fg)
    end

    return true, "ok"
end

-- ============================================================
-- CLEAN WITH VERIFY
-- ============================================================

local function CleanWithVerify(target, door)
    local warpStr = (door and door ~= "") and (target .. "|" .. door) or target
    local attempt, warpFails = 0, 0

    while true do
        attempt = attempt + 1
        WaitOnline()
        HandOverToMalady(nil)
        ExpectedWorld = ""

        local inWorld = CurrentWorld() == target
            or WarpTo(warpStr)
            or (warpStr ~= target and WarpTo(target))

        if not inWorld then
            warpFails = warpFails + 1
            if warpFails >= 3 then return false, false end
        else
            warpFails, ExpectedWorld = 0, target

            if Mode == "ROTASI" then
                BreakSmallLock()
            else
                local dx, dy = FindDoor()
                ClearDoorArea(dx, dy)
                for _, p in ipairs(LockTiles()) do BreakTile(p[1], p[2]) end
            end

            CleanJunk()
            CollectInWorld()

            if StillHere() then
                local ok1 = VerifyWorld(target)
                if ok1 then
                    Sleep(2000, 3000)
                    local ok2 = VerifyWorld(target)
                    if ok2 then
                        ExpectedWorld = ""
                        return true, false
                    end
                end
            end

            if not StillHere() then
                ExpectedWorld = ""
                return false, true
            end
        end

        if attempt >= MaxAttemptBersih then
            ExpectedWorld = ""
            return false, false
        end
        Sleep(1500, 2500)
    end
end

-- ============================================================
-- LEVELING
-- ============================================================

local function IsProtected(fg)
    return fg > 0 and (Unbreakable[fg] or LockIDs[fg]) and true or false
end

local function SetupHomeWorld()
    local hasFirst = false
    for _, p in ipairs(LockTiles()) do
        if GetTile(p[1], p[2]) == FirstLockId then hasFirst = true end
    end
    if not hasFirst then return nil end

    local name = CurrentWorld()
    pcall(function() bot.home_world = name end)
    return name
end

local function HasWork(x, y)
    local t = getTile(x, y)
    if not t then return false end
    if t.fg > 0 then return not IsProtected(t.fg) end
    return t.bg > 0
end

local function ClearForXP(x, y)
    for _ = 1, 60 do
        if not HasWork(x, y) or not Approach(x, y) then return end
        bot:hit(x, y)
        Sleep(115, 135)
    end
end

local function RunLeveling(levelWorld)
    pcall(function() bot.auto_collect = true end)

    local tiles = 0
    local deadline = os.time() + TimeoutLeveling

    local function Finished()
        return GetLevel() >= TargetLevel or os.time() > deadline
    end

    local function Housekeep()
        WaitOnline()
        HandOverToMalady(nil)
        if tiles % 20 == 0 then
            EnableMalady()
            CleanJunk()
        end
        if levelWorld ~= nil and CurrentWorld() ~= levelWorld then
            pcall(function() bot.auto_collect = false end)
            WarpTo(levelWorld)
            pcall(function() bot.auto_collect = true end)
        end
    end

    local rightToLeft, done = true, false
    for y = 0, 59 do
        if done then break end

        local hasWork = false
        for x = 0, 99 do
            if HasWork(x, y) then hasWork = true; break end
        end

        if hasWork then
            local first, last, step = 99, 0, -1
            if not rightToLeft then first, last, step = 0, 99, 1 end

            for x = first, last, step do
                tiles = tiles + 1
                if Finished() then done = true; break end
                Housekeep()
                if HasWork(x, y) then ClearForXP(x, y) end
            end
            rightToLeft = not rightToLeft
        end
    end

    while not Finished() do
        tiles = tiles + 1
        Housekeep()

        local bx, by = Pos()
        local tx = IsProtected(GetTile(bx + 1, by)) and bx - 1 or bx + 1
        if InBounds(tx, by) and not IsProtected(GetTile(tx, by)) and Count(BlokLeveling) > 0 then
            if GetTile(tx, by) == 0 then
                bot:place(tx, by, BlokLeveling)
                Sleep(85, 105)
            end
            if GetTile(tx, by) > 0 then bot:hit(tx, by) end
        end
        Sleep(115, 135)
    end

    if GetLevel() < TargetLevel then
        AddHistory("Leveling timeout, lanjut tanpa mencapai target level")
    end
    pcall(function() bot.auto_collect = false end)
end

-- ============================================================
-- AUTO BUILD
-- ============================================================

local function ApplyDoorId(build)
    if IdDoor == "0" then return end
    pcall(function() build.custom_id = tostring(IdDoor) end)
end

local function DebugAutoBuildFields(build)
    pcall(function()
        local fields = {}
        for k, v in pairs(build) do
            if type(v) ~= "function" and type(v) ~= "userdata" then
                table.insert(fields, string.format("%s=%s", tostring(k), tostring(v)))
            end
        end
        if #fields > 0 then
            print("[AUTO_BUILD] Field: " .. table.concat(fields, " | "))
        end
    end)
end

local function ApplyBuildConfig(build)
    local settings = {
        { "enabled", false }, { "soil_mode", false }, { "insert_rotation", true },
        { "ignore_lava", false }, { "ignore_cave", false }, { "build_water", false },
        { "build_plat", UsePlatform }, { "use_fire_house", false },
        { "item_storage", WorldStorage }, { "soil_storage", "" },
        { "output_path", FileHasil }, { "name_length", PanjangNama },
        { "door_id", DoorId }, { "entrance_id", EntranceId }, { "platform_id", PlatformId },
        { "no_number", true },
    }
    for _, s in ipairs(settings) do
        pcall(function() build[s[1]] = s[2] end)
    end
    DebugAutoBuildFields(build)
end

local function HasNumberInWorldName(name)
    return string.match(name, "%d") ~= nil
end

-- ============================================================
-- MAIN
-- ============================================================

local function Main()
    SetupInternalFiles()
    if Mode ~= "PUTWL" and Mode ~= "ROTASI" then Mode = "PUTWL" end

    PrevStatus = LoadStatusFile()
    LoadMessageId()
    print("[START] Auto DirtFarm berjalan.")

    WaitOnline()
    Sleep(math.min(tonumber(GetMyIndex()) or 1, 30) * 300)

    pcall(function()
        bot.anti_fire = true
        bot.anti_toxic = true
        bot.auto_trash = false
    end)

    local levelWorld = SetupHomeWorld()
    EnableMalady()
    HandOverToMalady(nil)

    if GetLevel() < TargetLevel then RunLeveling(levelWorld) end

    local build = bot.auto_build
    if not build then
        print("[ERROR] bot.auto_build tidak tersedia.")
        return
    end

    ApplyBuildConfig(build)
    ApplyDoorId(build)
    pcall(function() bot.auto_collect = false end)
    SetBuild(build, false)

    local me = GetMyName()
    local storageName = string.upper(string.match(WorldStorage, "^([^|:]+)") or WorldStorage)
    local cleaned = LoadWorldSet(FileBersih)
    local owners = LoadOwners()
    local lastRefresh, lastRestock = os.time(), 0
    local myWorlds, fails, retryAt = {}, {}, {}

    for world, owner in pairs(owners) do
        if owner == me and not cleaned[world] then myWorlds[world] = true end
    end

    local function MarkCurrentWorld()
        local cur = CurrentWorld()
        if cur ~= "" and cur ~= "EXIT" and cur ~= storageName and not cleaned[cur] and not myWorlds[cur] then
            myWorlds[cur], owners[cur] = true, me
            AppendOwner(cur, me)
            if HasNumberInWorldName(cur) then
                AddHistory(string.format("Warning: world %s mengandung angka", cur))
            end
        end
    end

    SweepDirtfarm()

    local function CountMyWorlds()
        local n = 0
        for _ in pairs(myWorlds) do n = n + 1 end
        return n
    end

    local function Step()
        WaitOnline()
        EnableMalady()
        HandOverToMalady(build)
        CheckWebhook()
        MarkCurrentWorld()

        if os.time() - lastRefresh >= RefreshBersihDtk then
            cleaned, owners, lastRefresh = LoadWorldSet(FileBersih), LoadOwners(), os.time()
            if IsLeader() then SweepDirtfarm() end
        end

        local recorded = LoadWorldSet(FileHasil)

        local myCount = CountMyWorlds()
        local limitReached = myCount >= MaxWorldPerAkun

        local pendingMine = 0
        for w in pairs(myWorlds) do
            if recorded[w] and not cleaned[w] and (retryAt[w] or 0) <= os.time() then
                pendingMine = pendingMine + 1
            end
        end

        BuildBlocked = pendingMine > 0
        local shouldBuild = (not BuildBlocked) and (not limitReached)

        if shouldBuild and BuildState ~= true then
            SetBuild(build, true)
        elseif (not shouldBuild) and BuildState ~= false then
            SetBuild(build, false)
        end

        if limitReached and BuildState ~= false then
            AddHistory(string.format("Batas world tercapai (%d/%d), auto-build off", myCount, MaxWorldPerAkun))
            SetBuild(build, false)
        end

        local target = nil
        for w in pairs(myWorlds) do
            if recorded[w] and not cleaned[w] and (retryAt[w] or 0) <= os.time() then
                target = w
                break
            end
        end

        if not target then
            for _ = 1, 4 do
                Sleep(400, 600)
                MarkCurrentWorld()
            end
            return
        end

        SetBuild(build, false)
        Sleep(1500, 2000)

        local fillEmpty = Count(FillId) < 1
        if fillEmpty or (MissingItem() and os.time() - lastRestock > 120) then
            lastRestock = os.time()
            RestockAtStorage(storageName)
        end

        if Count(FillId) < 1 then
            retryAt[target] = os.time() + JedaUlangDetik
            AddHistory(string.format("Bot %s: blok pengisi (id %d) habis, %s ditunda",
                tostring(GetMyIndex()), FillId, target))
            SendWebhook("Blok pengisi (1,2) habis di tas dan storage")
            return
        end

        local ok, interrupted = CleanWithVerify(target, recorded[target])

        if interrupted then
            if not HandOverToMalady(build) then WaitCalm(10) end
            return
        end

        if ok then
            cleaned[target], myWorlds[target], fails[target] = true, nil, nil

            local teksSimpan = target
            if Mode == "ROTASI" then
                local doorTarget = recorded[target]
                if doorTarget and doorTarget ~= "" then
                    teksSimpan = target .. ":" .. doorTarget
                else
                    teksSimpan = target .. ":" .. IdDoor
                end
            end

            if AppendLine(FileBersih, teksSimpan) and LoadWorldSet(FileBersih)[target] ~= nil then
                SweepDirtfarm()
            end
            AddHistory(string.format("Bot %s: Lolos inspeksi final", tostring(GetMyIndex())))
        else
            fails[target] = (fails[target] or 0) + 1
            AddHistory(string.format("Bot %s: gagal bersihkan %s (%d/%d)",
                tostring(GetMyIndex()), target, fails[target], MaxGagal))
            if fails[target] >= MaxGagal then
                fails[target] = 0
                retryAt[target] = os.time() + JedaUlangDetik
            end
        end

        SendWebhook()
        if not RestockAtStorage(storageName) then SendWebhook("Item tas belum sesuai kuota") end
    end

    while true do
        local ok, err = pcall(Step)
        if not ok then
            print("[ERROR] Step: " .. tostring(err))
            pcall(function() AddHistory("Error: " .. tostring(err)) end)
            ExpectedWorld = ""
            pcall(function() bot.auto_collect = false end)
            if not BuildBlocked then SetBuild(build, true) end
            Sleep(5000, 8000)
        end
    end
end

-- ============================================================
-- STARTUP
-- ============================================================

while true do
    local ok, err = pcall(Main)
    if not ok then
        print("[FATAL] " .. tostring(err))
        pcall(function() AddHistory("Fatal: " .. tostring(err)) end)
    else
        print("[INFO] Main berhenti, memulai ulang...")
    end
    ExpectedWorld = ""
    Sleep(10000, 15000)
end