local function Try(fn)
    local ok, value = pcall(fn)
    if ok then return value end
end

local WebhookTick = nil

local function Sleep(a, b)
    sleep(math.random(a, b or a))
    if WebhookTick then WebhookTick() end
end

local function InBounds(x, y)
    return x >= 0 and x <= 99 and y >= 0 and y <= 59
end

local function Count(id)
    return Try(function() return getInventory():getItemCount(id) end) or 0
end

local function CurrentWorld()
    return string.upper(tostring(Try(function() return getWorld().name end) or ""))
end

local function GetTile(x, y)
    local t = getTile(x, y)
    return t and t.fg or -1
end

local function Pos()
    local bx, by = Try(function() return bot.x, bot.y end)
    if type(bx) == "number" and bx > 0 and type(by) == "number" then
        return bx, by
    end
    local me = getLocal()
    if not me then return 0, 0 end
    return math.floor(me.posx / 32), math.floor(me.posy / 32)
end

local function OnTile(x, y)
    local bx, by = Pos()
    return bx == x and by == y
end

local function Near(x, y)
    local bx, by = Pos()
    return math.abs(bx - x) <= 2 and math.abs(by - y) <= 2
end

local function GetLevel()
    local lvl = Try(function() return bot.level end)
    if type(lvl) == "number" then
        LastLevel = lvl
        return lvl
    end
    return LastLevel or TargetLevel
end

