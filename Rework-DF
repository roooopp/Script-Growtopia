local function RunCommand(cmd)
    if not pcall(function() os.execute(cmd) end) then
        pcall(function()
            local p = io.popen(cmd)
            if p then p:read("a"); p:close() end
        end)
    end
end

local function SetupInternalFiles()
    RunCommand('mkdir "' .. Folder .. '" 2>nul')
    RunCommand('attrib +h "' .. Folder .. '"')
    local test = io.open(Folder .. "/log.txt", "a")
    if test then
        test:close()
        for key in pairs(Files) do
            Files[key] = Folder .. "/" .. key .. ".txt"
        end
    end
end

local function EachLine(path, fn)
    local f = io.open(path, "r")
    if f then
        for line in f:lines() do fn(line) end
        f:close()
    end
end

local function AppendLine(path, text)
    local f = io.open(path, "a")
    if not f then return false end
    f:write(text .. "\n")
    f:close()
    return true
end

local function WriteLines(path, lines)
    local f = io.open(path, "w")
    if not f then return false end
    for _, line in ipairs(lines) do f:write(line .. "\n") end
    f:close()
    return true
end

