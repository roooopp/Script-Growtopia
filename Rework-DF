local function HandOverToMalady(build)
    if not IsMaladyNone() then return false end

    SetBuild(build, false)
    pcall(function() bot.auto_collect = false end)

    while IsMaladyNone() do
        EnableMalady()
        CheckWebhook()
        WaitOnline()
        Sleep(2000, 3000)
    end

    WaitCalm(10)
    SetBuild(build, not BuildBlocked)
