local function escapeJson(str)
    if not str then return "" end
    str = tostring(str)
    str = str:gsub("\\", "\\\\")
    str = str:gsub('"', '\\"')
    str = str:gsub("\n", "\\n")
    str = str:gsub("\r", "\\r")
    str = str:gsub("[\0-\8\11\12\14-\31]", function(c)
        return string.format("\\u%04x", string.byte(c))
    end)
    return str
end

local function kirimWebhook(metode, url, payload)
    local status, body = nil, nil
    local ok, err = pcall(function()
        local client = HttpClient.new()
        client.url = url
        client.method = metode
        client.content = payload
        if client.headers == nil then client.headers = {} end
        client.headers["Content-Type"] = "application/json; charset=utf-8"
        local hasil = client:request()
        if hasil then
            if type(hasil.error) == "number" and hasil.error ~= 0 then
                print("[WEBHOOK] Network error: " .. tostring(hasil:getError()))
                return
            end
            status = hasil.status
            body = hasil.body
        end
    end)
    if not ok then print("[WEBHOOK] Error HTTP: " .. tostring(err)) end
    return status, body
end

local function ReadHookStamp()
